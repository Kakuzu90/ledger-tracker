rules_version = '2';

// Deploy with:  firebase deploy --only firestore:rules
//
// Everything here belongs to one uid and is reachable by nobody else.
// `uid` comes from anonymous sign-in, so there is no account behind it
// — but it is still a uid Firebase issued and signed, which is what
// keeps one install out of another's rows.
service cloud.firestore {
  match /databases/{database}/documents {

    // users/{uid}/devices/{token}   — one row per browser, for push
    // users/{uid}/{table}/{id}      — the ledger itself, pushed up by
    //                                 the outbox in features/sync
    //
    // The collection is named rather than left open: a typo in a table
    // name should fail loudly, not quietly create a collection nobody
    // reads.
    match /users/{uid}/{collection}/{docId} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && collection in [
          'devices',
          'accounts',
          'categories',
          'transactions',
          'recurring',
          'contacts',
          'loans',
          'loanPayments',
          'budgets',
          'goals'
        ];
    }

    // Anything not named above stays closed, including as this grows.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
